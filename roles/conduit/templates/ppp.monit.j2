check network "{{ monit_ppp_if }}" with interface "{{ monit_ppp_if }}"
    if link up then exec "/usr/bin/env METHOD=monit IFACE=ppp0 /var/config/ifup_restart"
    if changed link capacity then alert

# pppd is started and stopped by monitor_modem.  monit restores its
# monitoring state across restarts, so a pppd check here would start
# ppp after a restart even when monitor_modem had stopped it.
