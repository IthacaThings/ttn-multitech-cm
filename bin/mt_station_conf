from __future__ import print_function
import argparse
import json
import logging
import os
import re
import sys

import requests
import requests.exceptions

def parse_args():
    """ Parse the arguments """

    eui_re = re.compile(r"^(?:eui-)?(?P<eui>[0-9a-fA-FF]{16})$")
    def eui(string):
        """ Valiate an EUI """
        match = eui_re.match(string)
        if not match:
            raise ValueError("EUI is not 16 hex digits with optional eui- prefix")
        return match.group('eui')

    def rotate_size(string):
        """ Expand size """

        if string.endswith("k"):
            multiplier = 1000
        elif string.endswith("M"):
            multiplier = 1000000
        elif string.endswith("G"):
            multiplier = 1000000000
        else:
            multiplier = 0

        if multiplier:
            return int(string[:-1]) * multiplier
        else:
            return int(string)

    parser = argparse.ArgumentParser(description="Fetch MT station.conf and force it to json")

    #	Debugging
    group = parser.add_argument_group("Debugging options")
    group.add_argument("-d", "--debug",
                       dest="debug", default=False,
                       action='store_true',
                       help="print debugging messages")
    group.add_argument("--nodebug",
                       dest="debug",
                       action='store_false',
                       help="print debugging messages")
    group.add_argument("-v", "--verbose",
                       dest="verbose", default=False,
                       action='store_true',
                       help="print verbose messages")
    group.add_argument("-n", "--noop",
                       dest="noop", default=False,
                       action='store_true',
                       help="Don't make changes, just list what we are going to do")

    #	Options
    group = parser.add_argument_group("Configuration options")
    group.add_argument("--url",
                       dest="url",
                       help="Upstream URL of the file")
    group.add_argument("--file",
                       dest="file",
                       help="Cached copy of the file, used instead of --url if present")
    group.add_argument("--routerid",
                       dest="routerid", type=eui,
                       help="Router EUI")
    group.add_argument("--gps",
                       dest="gps",
                       help="Path to GPS device")
    group.add_argument("--fuzzy-pps",
                       dest="fuzzy_pps", action="store_true",
                       help="Use fuzzy PPS on GPS")
    group.add_argument("--log-level",
                       dest="log_level",
                       help="Log Level")
    group.add_argument("--log-rotate",
                       dest="log_rotate", type=int,
                       help="Number of log files in rotation")
    group.add_argument("--log-size",
                       dest="log_size", type=rotate_size,
                       help="Maximum size of log file")
    group.add_argument("--log-file",
                       dest="log_file",
                       help="Log file name")
    group.add_argument("--tc-timeout",
                       dest="tc_timeout",
                       type=int,
                       help="Set tc_timeout value in seconds")

    group = parser.add_argument_group("Cache options")
    group = group.add_mutually_exclusive_group()
    group.add_argument("--check",
                       dest="check", default=False,
                       action='store_true',
                       help="Report if --file differs from --url")
    group.add_argument("--update",
                       dest="update", default=False,
                       action='store_true',
                       help="Replace --file with the contents of --url")

    options = parser.parse_args()
    if options.debug:
        options.verbose = options.debug
    if options.check or options.update:
        if not options.url or not options.file:
            parser.error("--check and --update require --url and --file")
    else:
        if not options.url and not options.file:
            parser.error("--url or --file is required")
        if not options.routerid:
            parser.error("--routerid is required")

    return options

def init_logging(options):
    """ Set up logging """

    logger = logging.getLogger()
    logger.handlers = []
    logger.addHandler(logging.StreamHandler())
    if options.debug:
        logger.setLevel('DEBUG')
    elif options.verbose:
        logger.setLevel('INFO')
    else:
        logger.setLevel('WARNING')

def fetch(url):
    """ Fetch the upstream file, returning the raw content """

    response = requests.get(url, timeout=30)
    logging.debug("Response %s: %s", response.status_code, response.reason)
    response.raise_for_status()

    return response.content

def parse(content):
    """ Parse the file, which MT sometimes posts with a BOM """

    return json.loads(content.decode('utf-8-sig'))

def check(options):
    """ Compare the cached copy with upstream """

    try:
        upstream = fetch(options.url)
    except requests.exceptions.RequestException as error:
        print("Unable to check %s: %s" % (options.url, error))
        return 1

    try:
        with open(options.file, "rb") as filep:
            cached = filep.read()
    except IOError as error:
        print("No cached copy of %s: %s" % (options.url, error))
        return 1

    if parse(cached) != parse(upstream):
        print("%s has changed from cached copy %s, run %s --update --url %s --file %s" %
              (options.url, options.file, sys.argv[0], options.url, options.file))
        return 1

    return 0

def update(options):
    """ Replace the cached copy with upstream """

    try:
        upstream = fetch(options.url)
        parse(upstream)
    except (requests.exceptions.RequestException, ValueError) as error:
        sys.exit(error)

    if not options.noop:
        with open(options.file, "wb") as filep:
            filep.write(upstream)

    return 0

def main():
    """ Figure out what we should do """

    options = parse_args()
    init_logging(options)

    if options.check:
        return check(options)
    if options.update:
        return update(options)

    try:
        if options.file and os.path.exists(options.file):
            with open(options.file, "rb") as filep:
                data = parse(filep.read())
        else:
            data = parse(fetch(options.url))
    except (requests.exceptions.RequestException, ValueError) as error:
        sys.exit(error)

    for section in ['station_conf','SX1301_conf']:
        if section not in data:
            logging.error("Section %s not found in station.conf", section)
            return 1

    data['station_conf']['routerid'] = options.routerid
    if options.log_file:
        data['station_conf']['log_file'] = options.log_file
    if options.log_level:
        data['station_conf']['log_level'] = options.log_level
    if options.log_rotate:
        data['station_conf']['log_rotate'] = options.log_rotate
    if options.log_size:
        data['station_conf']['log_size'] = options.log_size
    if options.gps:
        data['station_conf']['gps'] = options.gps
        data['station_conf']['pps'] = "fuzzy" if options.fuzzy_pps else "gps"
        data['SX1301_conf']['pps'] = True
    else:
        # Without a GPS, disable PPS on the radio.  Basic Station 2.0.5
        # rejects station.conf if station_conf.pps is not a string, so
        # leave that out.
        data['station_conf'].pop('pps', None)
        data['SX1301_conf']['pps'] = False
    if options.tc_timeout:
        for key in data['station_conf'].keys():
            if key.lower() == "tc_timeout":
                data['station_conf'][key] = "%ds" % options.tc_timeout
                break
        else:
            data['station_conf']["TC_TIMEOUT"] = "%ds" % options.tc_timeout

    print(json.dumps(data, indent=4))

    return 0

if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        print()
        sys.exit(1)


